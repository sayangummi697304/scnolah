--=== PROTECTION ===--
local function isPlayerRelated(obj)
    if not obj or not obj.Parent then return false end
    for _, player in pairs(Services.Players:GetPlayers()) do
        local char = player.Character
        if char and (obj == char or obj:IsDescendantOf(char)) then
            return true
        end
    end
    return false
end

local function isProtectedObject(obj)
    if not obj then return true end
    if State.protectedCache[obj] ~= nil then return State.protectedCache[obj] end
    if isPlayerRelated(obj) then State.protectedCache[obj] = true return true end
    
    local name = obj.Name:lower()
    for _, kw in ipairs({"ball", "bola", "soccer", "football", "goal", "net", "sphere"}) do
        if name:find(kw, 1, true) then
            State.protectedCache[obj] = true
            return true
        end
    end
    
    State.protectedCache[obj] = false
    return false
end

--=== OBJECT OPTIMIZER ===--
local function optimizeObject(obj)
    if not obj or not obj.Parent then return end
    if State.modifiedParts[obj] then return end
    if isProtectedObject(obj) then return end
    
    safePcall(function()
        if obj:IsA("BasePart") and not obj:IsA("Terrain") then
            obj.Material = Enum.Material.Plastic
            obj.CastShadow = false
            obj.Reflectance = 0
        end
        if obj:IsA("MeshPart") then obj.TextureID = "" end
        if obj:IsA("Texture") or obj:IsA("Decal") then obj.Transparency = 1 end
        if obj:IsA("SurfaceAppearance") then obj:Destroy() end
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or
           obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end)
    
    State.modifiedParts[obj] = true
end

