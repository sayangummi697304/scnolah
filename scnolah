local function isBallObject(obj)
    if not obj then return false end
    if not obj:IsA("BasePart") then return false end
    if isPlayerRelated(obj) then return false end
    
    local name = obj.Name:lower()
    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
    
    local keywords = {"ball", "bola", "soccer", "football", "soccerball", 
                      "matchball", "gameball", "sepak", "bolo", "sphere"}
    
    for _, kw in ipairs(keywords) do
        if name:find(kw, 1, true) or parentName:find(kw, 1, true) then
            return true
        end
    end
    
    local isBall = false
    safePcall(function()
        if obj.Shape == Enum.PartType.Ball then isBall = true end
    end)
    if isBall then return true end
    
    local isRound = false
    safePcall(function()
        local s = obj.Size
        local minS, maxS = math.min(s.X, s.Y, s.Z), math.max(s.X, s.Y, s.Z)
        isRound = (maxS - minS) < 0.8 and maxS < 4 and maxS > 0.5
    end)
    
    return isRound
end

local function addBall(obj)
    if not obj or BallState.ballSet[obj] then return end
    if not isBallObject(obj) then return end
    
    BallState.ballSet[obj] = true
    table.insert(BallState.balls, obj)
    debugPrint("⚽ Ball added:", obj.Name)
    
    local conn
    conn = obj.AncestryChanged:Connect(function(_, parent)
        if not parent then
            BallState.ballSet[obj] = nil
            conn:Disconnect()
            debugPrint("⚽ Ball removed:", obj.Name)
        end
    end)
end

local function cleanBalls()
    for i = #BallState.balls, 1, -1 do
        local ball = BallState.balls[i]
        if not ball or not ball.Parent then
            BallState.ballSet[ball] = nil
            table.remove(BallState.balls, i)
        end
    end
end

local function fullBallScan()
    local found = 0
    for _, obj in pairs(workspace:GetDescendants()) do
        if isBallObject(obj) and not BallState.ballSet[obj] then
            addBall(obj)
            found = found + 1
        end
    end
    cleanBalls()
    if found > 0 then
        debugPrint("🔍 Scan found " .. found .. " new balls")
    end
    return #BallState.balls
end

local function updateBodyParts()
    BallState.bodyParts = {}
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(BallState.bodyParts, {
                part = part,
                multiplier = BR.BODY_MULTIPLIERS[part.Name] or 0.8,
            })
        end
    end
end

local function reactBall(ball, bodyData, distance)
    if not ball or not ball.Parent then return end
    if not bodyData or not bodyData.part.Parent then return end
    
    local part = bodyData.part
    local now = tick()
    local key = tostring(ball) .. part.Name
    
    if BallState.lastReact[key] and now - BallState.lastReact[key] < BR.COOLDOWN then
        return
    end
    
    local dir = (ball.Position - part.Position)
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 1, 0) end
    dir = dir.Unit
    
    local partVel = Vector3.zero
    safePcall(function() partVel = part.AssemblyLinearVelocity or Vector3.zero end)
    
    local distMult = math.clamp(1 - (distance / BR.REACT_DISTANCE), 0.3, 1)
    local force = dir * BR.REACT_FORCE * bodyData.multiplier * distMult
    local inherited = partVel * BR.VELOCITY_INHERIT
    local upBoost = Vector3.new(0, BR.REACT_FORCE * BR.UPWARD_BOOST, 0)
    local final = force + inherited + upBoost
    
    if final.Magnitude > 150 then final = final.Unit * 150 end
    
    safePcall(function() ball.AssemblyLinearVelocity = final end)
    safePcall(function() ball.Velocity = final end)
    
    safePcall(function()
        local spin = dir:Cross(Vector3.new(0, 1, 0))
        if spin.Magnitude > 0.1 then
            ball.AssemblyAngularVelocity = spin.Unit * BR.SPIN_FORCE
        end
    end)
    
    if firetouchinterest then
        safePcall(function()
            firetouchinterest(part, ball, 0)
            task.defer(function() firetouchinterest(part, ball, 1) end)
        end)
    end
    
    BallState.lastReact[key] = now
    BallState.reactCount = BallState.reactCount + 1
    debugPrint(string.format("⚽ React! Part: %s | Force: %.1f", part.Name, final.Magnitude))
end

local function startAutoReact()
    fullBallScan()
    updateBodyParts()
    
    workspace.DescendantAdded:Connect(function(obj)
        task.defer(function()
            if isBallObject(obj) then
                addBall(obj)
            end
        end)
    end)
    
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.3)
        updateBodyParts()
    end)
    
    task.spawn(function()
        while State.isRunning do
            task.wait(BR.AUTO_SCAN_INTERVAL)
            fullBallScan()
        end
    end)
    
    Services.RunService.Heartbeat:Connect(function()
        if not BR.ENABLED or not State.isRunning then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        if #BallState.bodyParts == 0 then updateBodyParts() end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hrpPos = hrp.Position
        
        for _, ball in ipairs(BallState.balls) do
            if not ball or not ball.Parent then continue end
            
            local roughDist = (ball.Position - hrpPos).Magnitude
            if roughDist > BR.REACT_DISTANCE * 3 then continue end
            
            local closest, closestDist = nil, math.huge
            
            for _, bodyData in ipairs(BallState.bodyParts) do
                if not bodyData.part.Parent then continue end
                local dist = (ball.Position - bodyData.part.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = bodyData
                end
            end
            
            if closest and closestDist <= BR.REACT_DISTANCE then
                reactBall(ball, closest, closestDist)
            end
        end
    end)
end

task.spawn(startAutoReact)

