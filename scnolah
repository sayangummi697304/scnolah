            if typeof(obj) == "Instance" and not obj.Parent then
                State.modifiedParts[obj] = nil
                State.protectedCache[obj] = nil
            end
        end
        local now = tick()
        for key, time in pairs(BallState.lastReact) do
            if now - time > 5 then
                BallState.lastReact[key] = nil
            end
        end
        safePcall(collectgarbage, "collect")
    end
end)

