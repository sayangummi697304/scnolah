--=== FUNCTION: CHECK PLAYER PART ===--
local function isPlayerPart(obj)
    if not obj or not obj.Parent then return false end
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and obj:IsDescendantOf(player.Character) then
            return true
        end
    end
    return false
end

--=== FUNCTION: CHECK PROTECTED OBJECT ===--
local function isProtectedObject(obj)
    if not obj then return true end
    if protectedObjects[obj] then return true end
    
    local name = obj.Name:lower()
    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
    
    local protectedNames = {
        "ball", "bola", "soccer", "football", "soccerball", "footballball",
        "matchball", "gameball", "playball", "kickball",
        "projectile", "bullet", "throw", "kick", "shoot",
        "tps", "goal", "net", "post", "crossbar",
        "sphere", "orb", "round"
    }
    
    for _, keyword in ipairs(protectedNames) do
        if name:find(keyword) or parentName:find(keyword) then
            protectedObjects[obj] = true
            return true
        end
    end
    
    local current = obj.Parent
    local depth = 0
    while current and current ~= workspace and depth < 5 do
        local currentName = current.Name:lower()
        for _, keyword in ipairs(protectedNames) do
            if currentName:find(keyword) then
                protectedObjects[obj] = true
                return true
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    
    if obj:IsA("BasePart") then
        pcall(function()
            if obj.Shape == Enum.PartType.Ball then
                protectedObjects[obj] = true
            end
        end)
        
        if protectedObjects[obj] then return true end
        
        pcall(function()
            local size = obj.Size
            local isRound = math.abs(size.X - size.Y) < 0.5 and math.abs(size.Y - size.Z) < 0.5
            local isSmall = size.X < 5 and size.Y < 5 and size.Z < 5
            if isRound and isSmall then
                protectedObjects[obj] = true
            end
        end)
    end
    
    if obj:IsA("MeshPart") then
        pcall(function()
            local meshId = obj.MeshId:lower()
            if meshId:find("sphere") or meshId:find("ball") then
                protectedObjects[obj] = true
            end
        end)
    end
    
    return protectedObjects[obj] or false
end

--=== FUNCTION: APPLY PLASTIC ===--
local function applyPlastic(v)
    if not v or not v.Parent then return end
    if isPlayerPart(v) then return end
    if isProtectedObject(v) then return end
    if modifiedParts[v] then return end
    
    pcall(function()
        if v:IsA("BasePart") and not v:IsA("Terrain") then
            if isProtectedObject(v) then return end
            
            v.Material = Enum.Material.Plastic
            v.CastShadow = false
            v.Reflectance = 0
            
            if not connections[v] then
                connections[v] = v:GetPropertyChangedSignal("Material"):Connect(function()
                    if v.Material ~= Enum.Material.Plastic and not isProtectedObject(v) then
                        task.defer(function()
                            pcall(function()
                                v.Material = Enum.Material.Plastic
                            end)
                        end)
                    end
                end)
            end
            
            modifiedParts[v] = true
        end
        
        if v:IsA("MeshPart") and not isProtectedObject(v) then
            v.TextureID = ""
        end
        
        if v:IsA("Texture") then
            v.Transparency = 1
        end
        
        if v:IsA("Decal") then
            v.Transparency = 1
        end
        
        if v:IsA("SurfaceAppearance") and not isProtectedObject(v.Parent) then
            v.Parent = nil
        end
        
        if (v:IsA("SpecialMesh") or v:IsA("FileMesh")) and not isProtectedObject(v.Parent) then
            v.TextureId = ""
        end
        
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") 
        or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Beam") then
            v.Enabled = false
        end
    end)
end

--=== FUNCTION: FORCE REAPPLY ===--
local function forceReapply(v)
    if not v or not v.Parent then return end
    if isPlayerPart(v) then return end
    if isProtectedObject(v) then return end
    
    pcall(function()
        if v:IsA("BasePart") and not v:IsA("Terrain") then
            if isProtectedObject(v) then return end
            v.Material = Enum.Material.Plastic
            v.CastShadow = false
            v.Reflectance = 0
        end
        
        if v:IsA("MeshPart") and not isProtectedObject(v) then
            v.TextureID = ""
        end
        
        if v:IsA("Texture") or v:IsA("Decal") then
            v.Transparency = 1
        end
        
        if v:IsA("SurfaceAppearance") and not isProtectedObject(v.Parent) then
            v.Parent = nil
        end
        
        if (v:IsA("SpecialMesh") or v:IsA("FileMesh")) and not isProtectedObject(v.Parent) then
            v.TextureId = ""
        end
        
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") 
        or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Beam") then
            v.Enabled = false
        end
    end)
end

